#!/usr/bin/env bash
# Pre-commit hook: scan staged changes for secrets using gitleaks (via Docker).
#
# Enable for this clone with:
#   git config core.hooksPath .githooks
#
# Requires Docker. The hook is a no-op (with a warning) if `docker` is not on
# PATH, so contributors without Docker can still commit — at their own risk.
#
# To bypass intentionally for a single commit:
#   git commit --no-verify

set -euo pipefail

# Pin the gitleaks image to a known-good version. Bump deliberately.
GITLEAKS_IMAGE="zricethezav/gitleaks:v8.30.1"

if ! command -v docker >/dev/null 2>&1; then
  echo "[pre-commit] WARNING: 'docker' not found on PATH; skipping gitleaks scan." >&2
  echo "[pre-commit]          Install Docker to enable secret scanning." >&2
  exit 0
fi

# `gitleaks git --pre-commit --staged` scans the staged diff only (fast).
# `--redact` masks any matched secrets in the output so they don't leak
# further (e.g. into terminal scrollback or CI logs).
docker run --rm \
  -v "$(pwd):/repo" \
  -w /repo \
  "$GITLEAKS_IMAGE" \
  git --pre-commit --staged --redact --verbose
